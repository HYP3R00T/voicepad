/* VoicePad — minimal layout stylesheet */

Screen {
    layout: vertical;
}

/* ── header bar ── */
#header {
    height: 1;
    background: $panel;
    layout: horizontal;
    padding: 0 2;
}

#header-title {
    width: auto;
    content-align: left middle;
    color: $primary;
    text-style: bold;
    margin-right: 3;
}

#status {
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#status.ready        { color: $text-success; }
#status.recording    { color: $text-error; }
#status.transcribing { color: $text-warning; }
#status.error        { color: $text-error; }

#header-model {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

/* ── body ── */
#body {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

/* ── transcription panel ── */
#transcription {
    border: round $border-blurred;
    border-title-color: $primary;
    padding: 1 2;
    height: 10;
    min-height: 5;
    margin-bottom: 1;
    background: $surface;
    overflow-y: auto;
}

#tx-text {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#tx-text.placeholder {
    color: $text-disabled;
    text-style: italic;
}

#tx-meta {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

/* ── history section — two panes side by side ── */
#history-section {
    layout: horizontal;
    height: 1fr;
}

#history-list-pane {
    border: round $border-blurred;
    border-title-color: $text-muted;
    width: 65;
    height: 1fr;
    background: $surface;
    margin-right: 1;
}

#history-view-pane {
    border: round $border-blurred;
    border-title-color: $primary;
    width: 1fr;
    height: 1fr;
    background: $surface;
}

#history-options {
    width: 1fr;
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#history-viewer {
    width: 1fr;
    height: 1fr;
    background: transparent;
    padding: 0 1;
}
