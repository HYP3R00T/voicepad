/* ── VoiceButton — strip all Textual Button chrome ── */
VoiceButton {
    border: none;
    background: transparent;
    padding: 0 1;
    height: 1;
    min-width: 0;
}
VoiceButton:hover, VoiceButton:focus { background: transparent; }



Screen {
    layout: vertical;
    background: transparent;
}

/* ── header bar ── */
#header {
    height: 2;
    background: transparent;
    layout: horizontal;
    padding: 1 2 0 2;
}

/* ── separator between header and tabs ── */
#header-rule {
    height: 1;
    background: transparent;
    border-bottom: solid $border-blurred;
}

#header-title {
    width: auto;
    content-align: left middle;
    color: $primary;
    text-style: bold;
    margin-right: 1;
}

#header-version {
    width: auto;
    content-align: left middle;
    color: $text-muted;
    margin-right: 2;
}

#status {
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#status.ready        { color: $text-success; }
#status.recording    { color: $text-error; }
#status.transcribing { color: $text-warning; }
#status.error        { color: $text-error; }

#header-model {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

/* ── body + tabs ── */
#body {
    layout: vertical;
    height: 1fr;
    background: transparent;
}

Footer {
    background: transparent;
}

#tabs {
    height: 1fr;
    padding: 0;
    background: transparent;
}

#tabs Tabs,
#tabs ContentSwitcher,
#tabs TabPane {
    background: transparent;
}

Tabs .underline--bar {
    background: $border-blurred 50%;
    color: $border-blurred;
}

TabPane {
    padding: 1 2;
    height: 1fr;
    layout: vertical;
}

/* ── record tab ── */
#transcription {
    border: round $border-blurred;
    border-title-color: $primary;
    padding: 1 2;
    height: 1fr;
    background: transparent;
    overflow-y: auto;
}

#tx-text {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#tx-text.placeholder {
    color: $text-disabled;
    text-style: italic;
}

#tx-meta {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

/* ── copy button (record tab) — inherits VoiceButton default role ── */
#tx-copy-btn {
    margin-top: 1;
}

/* ── history tab ── */
#history-section {
    layout: horizontal;
    height: 1fr;
}

#history-list-pane {
    width: 36%;
    min-width: 34;
    max-width: 44;
    height: 1fr;
    margin-right: 2;
    border: round $border-blurred;
    border-title-color: $primary;
    border-title-style: bold;
    background: transparent;
}

#history-view-pane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border: round $border-blurred;
    border-title-color: $primary;
    border-title-style: bold;
    background: transparent;
}

#history-options {
    width: 1fr;
    height: 1fr;
    padding: 1 1;
    border: none;
    background: transparent;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#history-options > .option-list--option {
    padding: 0 1;
    color: $text-muted;
}

#history-options > .option-list--option-highlighted {
    padding: 0 1;
    color: $foreground;
    background: $primary 18%;
    text-style: bold;
}

#history-options:focus > .option-list--option-highlighted {
    color: $foreground;
    background: $primary 28%;
    text-style: bold;
}

#history-options > .option-list--option-hover {
    padding: 0 1;
    background: $primary 10%;
}

#history-detail {
    width: 100%;
    height: 4;
    padding: 1 2 0 2;
    border-bottom: solid $border-blurred;
    background: transparent;
}

#history-detail-title {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#history-detail-meta {
    width: 100%;
    height: 1;
    color: $text-muted;
}

#history-viewer {
    width: 1fr;
    height: 1fr;
    padding: 2 3;
    background: transparent;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

/* ── settings tab ── */
#settings-scroll {
    height: 1fr;
    width: 1fr;
    align-horizontal: center;
}

#settings-fields {
    layout: vertical;
    height: auto;
    width: 100%;
    max-width: 110;
    padding: 1 2 3 2;
}

.settings-group {
    layout: vertical;
    height: auto;
    width: 100%;
    margin-bottom: 3;
}

.settings-section-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

.settings-section-copy {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.settings-item {
    layout: vertical;
    height: auto;
    width: 100%;
    margin-top: 1;
}

.settings-key {
    height: 1;
    color: $foreground;
    text-style: bold;
}

.settings-help {
    height: 1;
    color: $text-disabled;
}

.settings-input {
    width: 100%;
    height: 2;
    margin-top: 0;
    padding: 0 1;
    border: none;
    border-bottom: solid $border-blurred;
    background: transparent;
}

.settings-input:focus {
    border: none;
    border-bottom: solid $primary;
    background: transparent;
}

Select.settings-input {
    padding: 0;
}

Select.settings-input > SelectCurrent {
    height: 2;
    padding: 0 1;
    border: none;
    border-bottom: solid $border-blurred;
    background: transparent;
}

Select.settings-input:focus > SelectCurrent {
    border: none;
    border-bottom: solid $primary;
    background: transparent;
    background-tint: transparent;
}

Select.settings-input > SelectOverlay {
    border: round $border;
    background: $surface;
}

.settings-toggle-row {
    width: 100%;
    height: 3;
    margin-top: 2;
    align: left middle;
}

.settings-toggle-copy {
    width: 1fr;
    height: 2;
}

#setting-copy {
    width: auto;
    height: 1;
    margin-top: 1;
    padding: 0;
    border: none;
    background: transparent;
}

#setting-copy:focus {
    border: none;
    background: transparent;
}

#shortcut-group {
    margin-bottom: 1;
}

#shortcut-status {
    margin-bottom: 0;
}

#shortcut-command {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 2;
    border-left: tall $primary;
    background: transparent;
    color: $text;
    content-align: left middle;
}

#shortcut-actions {
    width: 100%;
    height: 2;
    margin-top: 1;
}

#shortcut-copy-btn {
    margin-right: 2;
}

#settings-footer {
    layout: horizontal;
    height: 3;
    align: right middle;
    padding: 1 3 0 3;
    border-top: solid $border-blurred;
    background: transparent;
}

#settings-status {
    width: 1fr;
    content-align: left middle;
    color: $text-muted;
}

#settings-save-btn {
    width: auto;
}

/* ── info modal ── */
InfoModal {
    align: center middle;
}

#info-dialog {
    layout: vertical;
    padding: 3 5;
    width: 64;
    height: auto;
    border: tall $primary;
    background: $background;
}

/* Level 1 — strong: header */
#info-title {
    width: 100%;
    height: auto;
    text-align: center;
    color: $foreground;
    text-style: bold;
    margin-bottom: 2;
}

/* Level 2 — normal: tagline */
#info-subtitle {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text;
    margin-bottom: 2;
}

/* Features box — border only, same background as dialog */
#info-guarantees {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 1 3;
    margin-bottom: 2;
    border: round $border-blurred;
}

.guarantee-line {
    width: 100%;
    height: 1;
    color: $text;
}

/* Philosophy — centered, slightly dim */
#info-philosophy {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

/* Separator */
#info-divider, #info-divider2 {
    width: 100%;
    height: 0;
    border-bottom: solid $border-blurred;
    margin: 0 0 2 0;
}

/* Level 1 — CTA title */
#info-sponsor-title {
    width: 100%;
    height: 1;
    text-align: center;
    color: $foreground;
    text-style: bold;
    margin-bottom: 1;
}

/* CTA buttons row */
#info-links {
    width: 100%;
    height: 1;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

/* Both links — bold, primary blue, never underlined */
#github-link, #sponsor-link {
    width: auto;
    height: 1;
    color: $primary;
    link-color: $primary;
    link-background: transparent;
    link-style: bold;
    link-color-hover: $foreground;
    link-background-hover: transparent;
    link-style-hover: bold;
    text-style: bold;
    background: transparent;
    border: none;
    padding: 0 1;
}

#github-link:hover, #sponsor-link:hover {
    color: $foreground;
    text-style: bold;
    background: transparent;
}

#github-link:focus, #sponsor-link:focus {
    color: $primary;
    text-style: bold;
    background: transparent;
}

.link-separator {
    width: auto;
    height: 1;
    color: $border-blurred;
    padding: 0 1;
    content-align: center middle;
}

/* Micro text */
#info-microcopy {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-disabled;
    text-style: italic;
    margin-bottom: 2;
}

/* Level 3 — dim: metadata */
#info-meta {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-disabled;
    margin-bottom: 2;
}

/* ── info modal close button — inherits VoiceButton default role ── */

/* ── setup wizard modal ── */
SetupModal {
    align: center middle;
}

#wizard-dialog {
    layout: vertical;
    padding: 1 2;
    width: 70;
    height: auto;
    max-height: 28;
    border: tall $primary;
    background: $background;
}

#wizard-step-indicator {
    width: 100%;
    height: 1;
    text-align: right;
    color: $text-disabled;
    margin-bottom: 1;
}

#wizard-body {
    layout: vertical;
    height: auto;
    width: 100%;
}

.wizard-title {
    width: 100%;
    height: auto;
    text-align: center;
    color: $foreground;
    text-style: bold;
    margin-bottom: 1;
}

.wizard-text {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text;
    margin-bottom: 1;
}

.wizard-features {
    width: 100%;
    height: auto;
    color: $text;
    padding: 0 2;
    border: round $border-blurred;
    margin-bottom: 1;
    text-align: center;
    content-align: center middle;
}

.wizard-credit {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-disabled;
    margin-top: 1;
}

.wizard-hint {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

.wizard-status {
    width: 100%;
    height: 1;
    text-align: center;
    margin-top: 1;
}

#wizard-keybindings {
    width: 100%;
    height: auto;
    background: $background;
    border: round $border-blurred;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
}

#wizard-progress {
    width: 100%;
    margin-top: 1;
}

#wizard-progress > Bar {
    width: 1fr;
}

#wizard-keybindings > .datatable--header {
    display: none;
}

#wizard-model-select, #wizard-device-select {
    width: 100%;
    margin-top: 1;
}

#wizard-nav {
    layout: horizontal;
    height: 1;
    width: 100%;
    margin-top: 2;
    padding: 0;
}

/* ── wizard nav buttons — inherits VoiceButton roles ── */
#wizard-spacer {
    width: 1fr;
}

#wizard-next:disabled {
    color: $text-disabled;
}

/* ── delete confirmation modal ── */
DeleteConfirmModal {
    align: center middle;
}

#delete-dialog {
    layout: vertical;
    padding: 2 4;
    width: 52;
    height: auto;
    border: tall $error;
    background: $background;
}

#delete-title {
    width: 100%;
    height: 1;
    text-align: center;
    color: $error;
    text-style: bold;
    margin-bottom: 1;
}

#delete-name {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#delete-body {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text;
    margin-bottom: 2;
}

#delete-nav {
    layout: horizontal;
    height: 1;
    width: 100%;
}

/* ── delete modal buttons — inherits VoiceButton roles ── */
#delete-spacer {
    width: 1fr;
}

/* ── hotkey picker ── */
.hotkey-mod-row {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

.hotkey-checkbox {
    width: auto;
    margin-right: 2;
}

.hotkey-key-select {
    width: 24;
    margin-bottom: 1;
}

.hotkey-preview {
    height: 1;
    color: $text-muted;
    margin-top: 0;
}
