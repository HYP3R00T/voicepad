Screen {
    layout: vertical;
    padding: 1 2;
}

#status {
    height: 3;
    content-align: center middle;
    color: $text-muted;
    border-bottom: solid $border-blurred;
}

#transcript {
    height: 1fr;
    margin-top: 1;
    padding: 1 2;
    border: round $border-blurred;
    overflow-y: auto;
}

#metadata {
    height: 2;
    color: $text-muted;
    content-align: center middle;
}

#record {
    width: 24;
    align-horizontal: center;
    margin-top: 1;
}
