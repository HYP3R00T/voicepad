/* VoicePad — minimal layout stylesheet */

Screen {
    layout: vertical;
}

/* ── header bar ── */
#header {
    height: 1;
    background: $panel;
    layout: horizontal;
    padding: 0 2;
}

#header-title {
    width: auto;
    content-align: left middle;
    color: $primary;
    text-style: bold;
    margin-right: 3;
}

#status {
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#status.ready        { color: $text-success; }
#status.recording    { color: $text-error; }
#status.transcribing { color: $text-warning; }
#status.error        { color: $text-error; }

#header-model {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

/* ── body + tabs ── */
#body {
    layout: vertical;
    height: 1fr;
}

#tabs {
    height: 1fr;
    padding: 0;
}

TabPane {
    padding: 1 2;
    height: 1fr;
    layout: vertical;
}

/* ── record tab ── */
#transcription {
    border: round $border-blurred;
    border-title-color: $primary;
    padding: 1 2;
    height: 1fr;
    background: $surface;
    overflow-y: auto;
}

#tx-text {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#tx-text.placeholder {
    color: $text-disabled;
    text-style: italic;
}

#tx-meta {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

#tx-copy-btn {
    width: auto;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    margin-top: 1;
    padding: 0 1;
    min-width: 10;
}

#tx-copy-btn:hover {
    background: $boost;
    color: $primary;
}

#tx-copy-btn:disabled {
    color: $text-disabled;
}

/* ── history tab ── */
#history-section {
    layout: horizontal;
    height: 1fr;
}

#history-list-pane {
    border: round $border-blurred;
    border-title-color: $text-muted;
    width: 55;
    height: 1fr;
    background: $surface;
    margin-right: 1;
}

#history-view-pane {
    border: round $border-blurred;
    border-title-color: $primary;
    width: 1fr;
    height: 1fr;
    background: $surface;
    layout: vertical;
}

#history-options {
    width: 1fr;
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#history-viewer {
    width: 1fr;
    height: 1fr;
    background: transparent;
    scrollbar-gutter: auto;
    scrollbar-size-vertical: 1;
}

/* Override Markdown's default padding: 0 2 0 2 — remove right padding so
   content sits flush against the scrollbar with no dead space */
#history-view-pane MarkdownViewer > Markdown {
    padding: 0 0 0 2;
}

#retranscribe-btn {
    width: auto;
    height: 1;
    border: none;
    background: transparent;
    color: $text-warning;
    text-style: bold;
    margin: 1 2;
    padding: 0 1;
}

#retranscribe-btn:hover {
    background: $warning-muted;
    color: $warning;
}

#retranscribe-btn:disabled {
    color: $text-disabled;
}

/* ── transcribe file tab ── */
#tf-section {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#tf-input {
    width: 1fr;
    margin-right: 1;
}

#tf-btn {
    width: auto;
    height: 3;
    border: tall $border-blurred;
    background: transparent;
    color: $text-success;
    text-style: bold;
    padding: 0 2;
}

#tf-btn:hover {
    background: $success-muted;
    border: tall $success;
}

#tf-btn:disabled {
    color: $text-disabled;
    border: tall $border-blurred;
}

#tf-viewer {
    width: 1fr;
    height: 1fr;
    background: $surface;
    border: round $border-blurred;
    scrollbar-gutter: auto;
    scrollbar-size-vertical: 1;
}

#tf-viewer > Markdown {
    padding: 0 0 0 2;
}

/* ── settings tab ── */
#settings-scroll {
    height: 1fr;
    width: 1fr;
}

#settings-fields {
    layout: vertical;
    height: auto;
    width: 1fr;
    padding: 0 1;
}

.settings-row {
    layout: vertical;
    height: auto;
    width: 1fr;
    margin-bottom: 1;
    border-bottom: solid $border-blurred;
    padding-bottom: 1;
}

.settings-key {
    height: 1;
    color: $primary;
    margin-bottom: 0;
}

.settings-hint {
    height: 1;
    color: $text-muted;
    margin-bottom: 0;
}

.settings-input {
    width: 1fr;
    margin-top: 0;
}

#settings-footer {
    layout: horizontal;
    height: 3;
    align: right middle;
    padding: 0 2;
    border-top: solid $border-blurred;
}

#settings-status {
    width: 1fr;
    content-align: left middle;
    color: $text-muted;
}

#settings-save-btn {
    width: auto;
    height: 1;
    border: none;
    background: transparent;
    color: $text-success;
    text-style: bold;
    padding: 0 1;
}

#settings-save-btn:hover {
    background: $boost;
    color: $success;
}
