---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'
import { flatDocs } from '../../data/docs'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '')
    const route = slug.endsWith('/index') ? slug.slice(0, -'/index'.length) : slug
    return {
      params: { slug: route === 'index' ? undefined : route },
      props: { entry, slug },
    }
  })
}

interface Props {
  entry: CollectionEntry<'docs'>
  slug: string
}

const { entry, slug } = Astro.props
const { Content, headings } = await render(entry)
const metadata = flatDocs.find((item) => item.slug === slug)
const title = metadata?.label ?? slug
const description = metadata?.description ?? 'VoicePad documentation.'
---

<DocsLayout {slug} {title} {description} {headings}>
  <Content />
</DocsLayout>
