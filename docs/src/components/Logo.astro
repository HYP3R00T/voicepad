---
interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<span class="inline-flex items-center gap-2.5" aria-label="VoicePad">
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 28 28" fill="none">
      <path d="M7 14v2M11 9v10M15 5v18M19 9v10M23 12v4" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
    </svg>
  </span>
  {!compact && <span class="font-display text-[1.05rem] font-semibold tracking-[-0.025em] text-white">VoicePad</span>}
</span>
